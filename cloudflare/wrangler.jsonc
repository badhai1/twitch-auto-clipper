{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "twitch-auto-clipper-dispatcher",
  "main": "dispatcher.mjs",
  "compatibility_date": "2026-11-26",
  "workers_dev": false,
  "keep_vars": true,
  "vars": {
    "GITHUB_APP_ID": "5940599",
    "GITHUB_INSTALLATION_ID": "186219944",
    "TARGET_MODE": "probe"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["3-58/5 * * * *"]
  }
}
